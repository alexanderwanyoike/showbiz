{
  "name": "showbiz",
  "version": "1.0.2",
  "description": "AI-powered video storyboard desktop application",
  "author": "Alex Wanyoike <alex.m.wanyoike@gmail.com>",
  "desktopName": "showbiz.desktop",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev-electron.mjs",
    "build": "yarn package:electron",
    "dev:frontend": "vite dev",
    "dev:electron": "node scripts/dev-electron.mjs",
    "build:frontend": "vite build",
    "build:electron": "esbuild electron/main.ts electron/preload.ts --bundle --platform=node --format=cjs --external:electron --outdir=dist-electron --out-extension:.js=.cjs",
    "package:electron": "yarn build:frontend && yarn build:electron && electron-builder",
    "test": "vitest run && yarn test:distribution",
    "test:watch": "vitest",
    "test:distribution": "node --test scripts/prepare-release.test.mjs",
    "prepare:release": "node scripts/prepare-release.mjs"
  },
  "build": {
    "appId": "com.showbiz.app",
    "productName": "Showbiz",
    "directories": {
      "output": "dist-package"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "electron/migrations/*.sql",
      "!node_modules/**"
    ],
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "AudioVideo",
      "icon": "build/icons/icon.png",
      "extraResources": [
        {
          "from": "node_modules/ffmpeg-static/ffmpeg",
          "to": "bin/ffmpeg"
        },
        {
          "from": "node_modules/ffprobe-static/bin/linux/${arch}/ffprobe",
          "to": "bin/ffprobe"
        }
      ],
      "syncDesktopName": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "build/icons/icon.icns",
      "extraResources": [
        {
          "from": "node_modules/ffmpeg-static/ffmpeg",
          "to": "bin/ffmpeg"
        },
        {
          "from": "node_modules/ffprobe-static/bin/darwin/${arch}/ffprobe",
          "to": "bin/ffprobe"
        }
      ],
      "artifactName": "Showbiz-${version}-arm64-mac.${ext}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icons/icon.ico",
      "extraResources": [
        {
          "from": "node_modules/ffmpeg-static/ffmpeg.exe",
          "to": "bin/ffmpeg.exe"
        },
        {
          "from": "node_modules/ffprobe-static/bin/win32/${arch}/ffprobe.exe",
          "to": "bin/ffprobe.exe"
        }
      ]
    },
    "publish": {
      "provider": "github",
      "owner": "alexanderwanyoike",
      "repo": "showbiz",
      "private": false,
      "releaseType": "draft"
    },
    "electronUpdaterCompatibility": ">=2.16",
    "generateUpdatesFilesForAllChannels": false,
    "appImage": {
      "artifactName": "Showbiz-${version}.AppImage"
    },
    "deb": {
      "artifactName": "showbiz_${version}_amd64.deb"
    },
    "dmg": {
      "artifactName": "Showbiz-${version}-arm64.dmg"
    },
    "nsis": {
      "artifactName": "Showbiz.Setup.${version}.exe"
    }
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "1.0.4",
    "electron-updater": "^6.8.9",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "lucide-react": "^0.555.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-router": "^7",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4",
    "autoprefixer": "^10",
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1",
    "js-yaml": "^4.1.0",
    "jsdom": "^30.0.1",
    "postcss": "^8",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vite": "^6",
    "vitest": "^3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/alexanderwanyoike/showbiz.git"
  }
}
